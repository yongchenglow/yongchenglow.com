{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
	"semanticCommits": "enabled",
	"packageRules": [
		{
			"description": "Automerge minor and patch updates for stable packages (not v0.x). Branch protection holds the merge until every required check passes.",
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "!/^0/",
			"automerge": true,
			"automergeType": "pr",
			"automergeStrategy": "squash"
		},
		{
			"description": "Automerge TypeScript type definitions after CI passes",
			"matchPackageNames": ["/^@types//"],
			"automerge": true,
			"automergeType": "pr"
		},
		{
			"description": "Group all Next.js packages together",
			"matchPackageNames": ["next", "/^@next//"],
			"groupName": "Next.js"
		},
		{
			"description": "Group all React packages together",
			"matchPackageNames": [
				"react",
				"react-dom",
				"@types/react",
				"@types/react-dom"
			],
			"groupName": "React"
		},
		{
			"description": "Group all Radix UI packages together",
			"matchPackageNames": ["/^@radix-ui//"],
			"groupName": "Radix UI"
		},
		{
			"description": "Group unit test tooling together",
			"matchPackageNames": ["/^@testing-library//", "/^@happy-dom//"],
			"groupName": "Testing"
		},
		{
			"description": "Group Playwright packages; CI and e2e/docker.sh derive the browser image tag from @playwright/test",
			"matchPackageNames": ["/playwright/"],
			"groupName": "Playwright"
		},
		{
			"description": "Group GitHub Actions and shared ci-workflows updates. Actions are pinned to commit SHAs and receive credentials, so they are reviewed by hand rather than automerged.",
			"matchManagers": ["github-actions"],
			"groupName": "GitHub Actions",
			"automerge": false
		},
		{
			"description": "Schedule dependencies updates weekly",
			"matchDepTypes": ["dependencies", "devDependencies"],
			"extends": ["schedule:weekly"]
		},
		{
			"description": "Separate major updates for review",
			"matchUpdateTypes": ["major"],
			"labels": ["dependencies", "major-update"],
			"automerge": false
		}
	],
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"]
	},
	"osvVulnerabilityAlerts": true,
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 4am on Monday"]
	},
	"prConcurrentLimit": 10,
	"prHourlyLimit": 2,
	"labels": ["dependencies"],
	"timezone": "Asia/Singapore"
}
