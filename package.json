{
	"private": true,
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": "26.3.0"
	},
	"scripts": {
		"dev": "npm run generate-search-index && next dev",
		"build": "npm run generate-search-index && next build",
		"generate-search-index": "node scripts/generate-search-index.mjs",
		"test": "vitest",
		"tsc": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint --write",
		"start": "next start",
		"analyze": "ANALYZE=true next build",
		"format": "biome format --write",
		"check": "biome check --write",
		"check:all": "npm run tsc && npm run check && npm run knip",
		"check:ci": "biome check --write",
		"knip": "knip",
		"knip:production": "knip --production",
		"update:packages": "bun update --latest",
		"prepare": "husky",
		"release": "semantic-release",
		"lqip": "tsx scripts/generate-lqip.ts"
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.2.10",
		"@radix-ui/react-avatar": "^1.2.1",
		"@radix-ui/react-dialog": "^1.1.18",
		"@radix-ui/react-navigation-menu": "^1.2.17",
		"@radix-ui/react-scroll-area": "^1.2.13",
		"@radix-ui/react-separator": "^1.1.11",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-switch": "^1.3.2",
		"@radix-ui/react-tooltip": "^1.2.11",
		"@tailwindcss/postcss": "^4.3.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"flexsearch": "^0.8.212",
		"framer-motion": "^12.42.2",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.23.0",
		"mermaid": "^11.16.0",
		"next": "^16.2.10",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-syntax-highlighter": "^16.1.1",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"simple-icons": "^16.24.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@commitlint/cli": "^21.2.0",
		"@commitlint/config-conventional": "^21.2.0",
		"@next/bundle-analyzer": "^16.2.10",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/gitlab": "^13.3.3",
		"@swc/core": "^1.15.43",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/mdx": "^2.0.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
