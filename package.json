{
	"private": true,
	"packageManager": "bun@1.4.3",
	"engines": {
		"bun": ">=1.4.3"
	},
	"scripts": {
		"dev": "bun run generate-search-index && bun --bun next dev",
		"build": "bun run generate-search-index && bun --bun next build",
		"generate-search-index": "bun scripts/generate-search-index.mjs",
		"test": "bun test",
		"e2e": "playwright test --grep-invert @visual",
		"e2e:ui": "playwright test --ui --grep-invert @visual",
		"e2e:smoke": "playwright test --grep @smoke",
		"e2e:docker": "sh e2e/docker.sh",
		"e2e:update": "sh e2e/docker.sh --grep @visual --update-snapshots=all",
		"e2e:update:ci": "sh e2e/update-ci-snapshots.sh",
		"e2e:install": "playwright install chromium",
		"e2e:serve": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/ && bun .next/standalone/server.js",
		"tsc": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint --write",
		"start": "bun --bun next start",
		"analyze": "ANALYZE=true bun --bun next build",
		"format": "biome format --write",
		"check": "biome check --write",
		"check:all": "bun run tsc && bun run check && bun run knip",
		"check:ci": "biome check --write",
		"knip": "knip",
		"knip:production": "knip --production",
		"update:packages": "bun update --latest",
		"prepare": "husky",
		"lqip": "bun scripts/generate-lqip.ts",
		"images": "bun scripts/optimize-images.ts && bun run lqip"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.4.3",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-navigation-menu": "^1.4.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tailwindcss/postcss": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"flexsearch": "^0.8.212",
		"framer-motion": "^14.6.0",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.61.0",
		"mermaid": "^12.2.0",
		"next": "^16.4.3",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-syntax-highlighter": "^16.1.2",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"simple-icons": "^16.35.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.2",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@happy-dom/global-registrator": "^21.0.4",
		"@next/bundle-analyzer": "^16.4.3",
		"@playwright/test": "1.64.1",
		"@swc/core": "^1.16.20",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.4",
		"@types/mdx": "^2.0.14",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"autoprefixer": "^10.6.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"knip": "^6.43.0",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.31",
		"shadcn": "^4.22.1",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
