{
	"private": true,
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": "26.8.1"
	},
	"scripts": {
		"dev": "npm run generate-search-index && next dev",
		"build": "npm run generate-search-index && next build",
		"generate-search-index": "node scripts/generate-search-index.mjs",
		"test": "vitest",
		"tsc": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint --write",
		"start": "next start",
		"analyze": "ANALYZE=true next build",
		"format": "biome format --write",
		"check": "biome check --write",
		"check:all": "npm run tsc && npm run check && npm run knip",
		"check:ci": "biome check --write",
		"knip": "knip",
		"knip:production": "knip --production",
		"update:packages": "bun update --latest",
		"prepare": "husky",
		"release": "semantic-release",
		"lqip": "tsx scripts/generate-lqip.ts"
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.3.4",
