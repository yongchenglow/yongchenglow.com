{
	"private": true,
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2",
		"node": "26.10.0"
	},
	"scripts": {
		"dev": "bun run generate-search-index && bun --bun next dev",
		"build": "bun run generate-search-index && bun --bun next build",
		"generate-search-index": "bun scripts/generate-search-index.mjs",
		"test": "bun test",
		"tsc": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "bun node_modules/@biomejs/biome/bin/biome lint --write",
		"start": "bun --bun next start",
		"analyze": "ANALYZE=true bun --bun next build",
		"format": "bun node_modules/@biomejs/biome/bin/biome format --write",
		"check": "bun node_modules/@biomejs/biome/bin/biome check --write",
		"check:all": "bun run tsc && bun run check && bun run knip",
		"check:ci": "bun node_modules/@biomejs/biome/bin/biome check --write",
		"knip": "knip",
		"knip:production": "knip --production",
		"update:packages": "bun update --latest",
		"prepare": "bun --bun husky",
		"lqip": "bun scripts/generate-lqip.ts",
		"images": "bun scripts/optimize-images.ts && bun run lqip",
		"lint-staged": "bun node_modules/lint-staged/bin/lint-staged.js"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css,md,mdx}": "bun node_modules/@biomejs/biome/bin/biome check --write"
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.3.6",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-navigation-menu": "^1.2.22",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tailwindcss/postcss": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"flexsearch": "^0.8.212",
		"framer-motion": "^13.4.4",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.48.0",
		"mermaid": "^12.0.0",
		"next": "^16.3.6",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-syntax-highlighter": "^16.1.1",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"simple-icons": "^16.32.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@happy-dom/global-registrator": "^20.14.5",
		"@next/bundle-analyzer": "^16.3.6",
		"@swc/core": "^1.16.2",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.2",
		"@types/mdx": "^2.0.14",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"autoprefixer": "^10.6.1",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"knip": "^6.38.0",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.28",
		"shadcn": "^4.21.0",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
