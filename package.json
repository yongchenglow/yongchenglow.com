		"semantic-release": "^25.0.5",
		"shadcn": "^4.13.0",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
