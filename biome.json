{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			".claude/**/*",
			".husky/**/*",
			"test/**/*",
			"e2e/**/*",
			"src/**/*",
			"*.ts",
			"*.js",
			"*.tsx",
			"*.jsx",
			"*.json",
			"!.claude/worktrees",
			"!.worktrees",
			"!node_modules",
			"!.next",
			"!dist",
			"!build",
			"!coverage",
			"!storybook-static",
			"!**/*.snap",
			"!**/__snapshots__"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noUnknownAtRules": "off"
			}
		}
	},
	"json": {
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		},
		"linter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["test/**"],
			"linter": {
				"domains": { "playwright": "none" }
			}
		},
		{
			"includes": ["e2e/smoke.e2e.ts", "e2e/visual.e2e.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"usePlaywrightValidDescribeCallback": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
