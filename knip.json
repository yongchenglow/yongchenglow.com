{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/app/**/*.{ts,tsx}", "src/components/**/*.{ts,tsx}"],
	"project": ["src/**/*.{ts,tsx}"],
	"ignore": [],
	"exclude": ["duplicates"],
	"ignoreDependencies": [
		"@swc/core",
		"autoprefixer",
		"globals",
		"shadcn",
		"tailwindcss-animate"
	],
	"next": {
		"entry": ["src/app/**/*.{ts,tsx}", "src/middleware.{ts,tsx}"]
	}
}
